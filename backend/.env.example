# Copy this file to .env and adjust as needed.
# Not required for local dev — SQLite + the dev SECRET_KEY fallback work with no config at all.

# DATABASE_URL=sqlite:///./attune.db
# For Postgres (typical for real deployment), it'd look like:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# SECRET_KEY signs login tokens. The app falls back to an insecure dev-only
# value if this isn't set — always set a real one (a long random string)
# before deploying anywhere real.
# SECRET_KEY=
